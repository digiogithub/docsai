  <xsd:import namespace="http://schemas.openxmlformats.org/officeDocument/2006/relationships" schemaLocation="ecma-376-part4-transitional/shared-relationshipReference.xsd"/>
  <xsd:import namespace="http://schemas.openxmlformats.org/spreadsheetml/2006/main" schemaLocation="ecma-376-part4-transitional/sml.xsd"/>
  <xsd:import namespace="urn:schemas-microsoft-com:vml" schemaLocation="ecma-376-part4-transitional/vml-main.xsd"/>
  <xsd:import namespace="urn:schemas-microsoft-com:office:office" schemaLocation="ecma-376-part4-transitional/vml-officeDrawing.xsd"/>
  <xsd:import namespace="urn:schemas-microsoft-com:office:powerpoint" schemaLocation="ecma-376-part4-transitional/vml-presentationDrawing.xsd"/>
  <xsd:import namespace="urn:schemas-microsoft-com:office:excel" schemaLocation="ecma-376-part4-transitional/vml-spreadsheetDrawing.xsd"/>
  <xsd:import namespace="urn:schemas-microsoft-com:office:word" schemaLocation="ecma-376-part4-transitional/vml-wordprocessingDrawing.xsd"/>
  <xsd:import namespace="http://schemas.openxmlformats.org/wordprocessingml/2006/main" schemaLocation="ecma-376-part4-transitional/wml.xsd"/>

  <xsd:import namespace="http://schemas.openxmlformats.org/package/2006/content-types" schemaLocation="ecma-376-part2-opc/opc-contentTypes.xsd"/>
  <xsd:import namespace="http://schemas.openxmlformats.org/package/2006/digital-signature" schemaLocation="ecma-376-part2-opc/opc-digSig.xsd"/>
  <xsd:import namespace="http://schemas.openxmlformats.org/package/2006/relationships" schemaLocation="ecma-376-part2-opc/opc-relationships.xsd"/>
</xsd:schema>
